# Per-Ankh build-time configuration. Copy this file to `.env` and fill in
# absolute paths for your local checkouts. The `.env` file itself is
# gitignored — only this template is committed.

# Path to your pinacotheca checkout (https://github.com/becked/pinacotheca).
# Required by scripts/bake-*.ts to read extracted sprites and pyproject.toml.
PINACOTHECA_DIR=

# Path to the Old World reference root containing an `XML/` subdir — typically
# a checkout of (or symlink into) the game install's reference data. Required
# by scripts/bake-improvements.ts to read improvement.xml + nation.xml + mods.
OLD_WORLD_REFERENCE_DIR=

# Path to your owtournamentatlas checkout
# (https://github.com/alcaras/owtournamentatlas) — the community map atlas.
# Required by scripts/bake-map-caveats.ts (run in bake:all) to read the atlas'
# generation stats (src/data/atlas-dist.json) and published pool (index.astro).
OWTOURNAMENTATLAS_DIR=

# Path to your owtt checkout (https://github.com/alcaras/owtt) — the tech-tree
# planner. Required by scripts/bake-owtt.ts to read tech-data.js and snapshot
# the deep-link encoding tables (src/lib/generated/owtt.ts).
OWTT_DIR=

# Directory of parsed duel blobs (the /v1/games/:id response JSON, one file
# per game) used by scripts/bake-momentum.ts to refit the momentum model.
# Only needed when refitting (e.g. after an Old World balance patch) — the
# fitted weights are committed in src/lib/generated/momentum.ts. Not part of
# bake:all, deliberately: a finished game's curve must not drift because a
# bake re-ran on a different corpus.
MOMENTUM_CORPUS_DIR=

# Cloudflare account id and an API token with Workers AI Read and Edit, used by
# scripts/eval-screenshot-classifier.ts (npm run eval:screenshots) to run the
# local screenshot corpus through Clef and set the upload gate's threshold
# bands. Only needed when re-running that eval; `--dry-run` needs neither.
# These are credentials — this file is the committed template, so fill the
# values into `.env`, never here.
#
# NOT named CLOUDFLARE_API_TOKEN: that is one of wrangler's own system
# environment variables, and wrangler reads `.env` from its project directory —
# which the repo root is (wrangler.toml, per-ankh-frontend). A Workers-AI-only
# token under that name would become wrangler's credential for every root-run
# deploy and preflight, overriding the OAuth login with a token that cannot
# touch Workers. CLOUDFLARE_ACCOUNT_ID is deliberately shared with wrangler —
# same account, same value.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# === Cloud rewrite ===
# Frontend env vars (VITE_API_URL, VITE_PUBLIC_ORIGIN) live in the
# committed `.env.development` file, which Vite auto-loads only in dev
# mode. Production code defaults handle `npm run build` with no env set.
# Nothing for users to configure here.
