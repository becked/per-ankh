{
	"name": "per-ankh-share-api",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"migrate:local": "wrangler d1 migrations apply per-ankh-share-index --local",
		"migrate:remote": "wrangler d1 migrations apply per-ankh-share-index --remote",
		"migrate:staging": "wrangler d1 migrations apply per-ankh-share-index-staging --env staging --remote",
		"migrate:security:local": "wrangler d1 migrations apply per-ankh-security-events --local",
		"migrate:security:remote": "wrangler d1 migrations apply per-ankh-security-events --remote",
		"migrate:security:staging": "wrangler d1 migrations apply per-ankh-security-events-staging --env staging --remote",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"fflate": "^0.8.3",
		"nanoid": "^5.0.0",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260722.1",
		"typescript": "^5.6.0",
		"vitest": "^4.1.6",
		"wrangler": "^4.0.0"
	},
	"overrides": {
		"esbuild": "0.28.1",
		"sharp": "^0.35.4",
		"undici": "^7.30.1",
		"zod": "^4.6.6"
	}
}
